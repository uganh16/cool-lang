{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Cool",
	"patterns": [
		{
			"include": "#class"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#objects"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#types"
		}
	],
	"repository": {
		"block": {
			"patterns": [
				{
					"name": "meta.block.cool",
					"begin": "\\{",
					"end": "\\}"
				}
			]
		},
		"class": {
			"patterns": [
				{
					"name": "meta.class.cool",
					"begin": "\\b(?i:class)\\b",
					"end": "\\}",
					"beginCaptures": {
						"0": { "name": "storage.type.cool" }
					}
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-dash.cool",
					"match": "--.*$"
				},
				{
					"name": "comment.block.cool",
					"begin": "\\(\\*",
					"end": "\\*\\)"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.numeric.cool",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.cool",
					"match": "\\b(case|else|esac|fi|if|in|let|loop|pool|then|while)\\b"
				},
				{
					"name": "keyword.operator.cool",
					"match": "\\b(isvoid|not)\\b"
				},
				{
					"name": "keyword.other.cool",
					"match": "\\b(class|inherits|new|of)\\b"
				},
				{
					"name": "constant.language.cool",
					"match": "\\b(f[aA][lL][sS][eE]|t[rR][uU][eE])\\b"
				}
			]
		},
		"objects": {
			"patterns": [
				{
					"name": "variable.language.cool",
					"match": "\\b(self)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.cool",
					"match": "\\*\\+|\\-|/|<-|<=|=>|~"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.cool",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.cool",
							"match": "\\."
						}
					]
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "support.class.cool",
					"match": "\\b(Int|String|Bool|Object|IO)\\b"
				},
				{
					"name": "support.type.cool",
					"match": "\\b(SELF_TYPE)\\b"
				},
				{
					"name": "entity.name.class.cool",
					"match": "\\b[A-Z][0-9A-Z_a-z]*\\b"
				}
			]
		}
	},
	"scopeName": "source.cool"
}
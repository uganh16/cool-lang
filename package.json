{
  "name": "cool-lang",
  "displayName": "Cool Lang",
  "description": "Cool (Classroom Object-Oriented Language) language support for Visual Studio Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "cool",
      "aliases": ["Cool", "cool"],
      "extensions": [".cl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "cool",
      "scopeName": "source.cool",
      "path": "./syntaxes/cool.tmLanguage.json"
    }]
  }
}
